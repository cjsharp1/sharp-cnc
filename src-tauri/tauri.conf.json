{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SharpCNC",
  "version": "0.3.0",
  "identifier": "com.sharpnc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SharpCNC",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Personal GRBL controller for one CNC",
    "longDescription": "SharpCNC is a personal GRBL controller for one custom CNC — USB serial to a Demon Shield / Arduino, with jog, probe, jobs, and a live machine view."
  }
}
